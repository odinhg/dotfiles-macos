#!/usr/bin/env bash
export PATH="/run/current-system/sw/bin:/opt/homebrew/bin:$PATH"

sketchybar --bar height=28 position=top color=0xff11172b

sketchybar --default \
    label.font="JetBrainsMono Nerd Font:Bold:13.0" \
    label.color=0xfff2e8cf \
    label.padding_left=8 \
    label.padding_right=8 \
    background.color=0xff2a3a6b \
    background.corner_radius=5 \
    background.height=20 \
    background.drawing=off

sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5; do
    sketchybar --add item space.$sid left \
        --set space.$sid \
        drawing=off \
        click_script="aerospace workspace $sid"
done

# Hidden item that updates all space.N items at once
sketchybar --add item spaces left \
    --subscribe spaces aerospace_workspace_change front_app_switched \
    --set spaces \
    drawing=off \
    update_freq=30 \
    script="$CONFIG_DIR/plugins/aerospace.sh"

sketchybar --add item clock right \
    --set clock \
    update_freq=10 \
    script="$CONFIG_DIR/plugins/clock.sh"

sketchybar --add item battery right \
    --subscribe battery power_source_change system_woke \
    --set battery \
    update_freq=120 \
    icon.font="JetBrainsMono Nerd Font:Regular:15.0" \
    icon.color=0xfff2e8cf \
    icon.padding_left=8 \
    label.padding_left=4 \
    script="$CONFIG_DIR/plugins/battery.sh"

sketchybar --add item volume right \
    --subscribe volume volume_change \
    --set volume \
    icon.font="JetBrainsMono Nerd Font:Regular:15.0" \
    icon.color=0xfff2e8cf \
    icon.padding_left=8 \
    label.padding_left=4 \
    script="$CONFIG_DIR/plugins/volume.sh"

sketchybar --add item wifi right \
    --subscribe wifi wifi_change system_woke \
    --set wifi \
    icon.font="JetBrainsMono Nerd Font:Regular:15.0" \
    icon.padding_left=8 \
    label.padding_left=4 \
    script="$CONFIG_DIR/plugins/wifi.sh"

sketchybar --add item memory right \
    --set memory \
    update_freq=15 \
    icon="󰍛" \
    icon.font="JetBrainsMono Nerd Font:Regular:15.0" \
    icon.color=0xfff2e8cf \
    icon.padding_left=8 \
    label.padding_left=4 \
    script="$CONFIG_DIR/plugins/memory.sh"

sketchybar --add item cpu right \
    --set cpu \
    update_freq=5 \
    icon="󰻠" \
    icon.font="JetBrainsMono Nerd Font:Regular:15.0" \
    icon.color=0xfff2e8cf \
    icon.padding_left=8 \
    label.padding_left=4 \
    script="$CONFIG_DIR/plugins/cpu.sh"

sketchybar --update
